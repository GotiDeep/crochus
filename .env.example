PORT=3000
NODE_ENV=development
PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:4200

PGHOST=localhost
PGPORT=5432
PGDATABASE=crochus
PGUSER=postgres
PGPASSWORD=your-local-postgres-password
# DATABASE_URL=
# DATABASE_SSL=false

JWT_SECRET=replace-with-a-long-random-customer-jwt-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace-with-a-different-long-random-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=replace-with-a-strong-admin-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Crochus <no-reply@crochus.local>"
CONTACT_RECEIVER_EMAIL=hello@crochus.com

CLOUDINARY_CLOUD_NAME=
